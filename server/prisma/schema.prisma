generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @map("_id")
  username     String    @unique
  password     String
  name         String?
  role         String    @default("agent")
  tlId         String?   @map("tl_id")
  adminId      String?   @map("admin_id")
  receiverMail String?   @map("receiver_mail")
  smtpGmail    String?   @map("smtp_gmail")
  smtpPassword String?   @map("smtp_password")
  active       Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  agentWorkLogs AgentWorkLog[]

  @@map("users")
}

model AgentWorkLog {
  id               String    @id @default(uuid()) @map("_id")
  userId           String    @map("user_id")
  loginAt          DateTime  @default(now()) @map("login_at")
  logoutAt         DateTime? @map("logout_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  lunchDuration    Int       @default(0) @map("lunch_duration")
  bioDuration      Int       @default(0) @map("bio_duration")
  teaDuration      Int       @default(0) @map("tea_duration")
  activeBreakType  String?   @map("active_break_type")
  activeBreakStart DateTime? @map("active_break_start")
  totalWorkTime    Int       @default(0) @map("total_work_time")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@map("agent_work_logs")
}

model Contact {
  id                String    @id @default(uuid()) @map("_id")
  fields            Json?
  batchId           String?   @map("batch_id")
  assignedTo        String?   @map("assigned_to")
  agentName         String?   @map("agent_name")
  adminId           String?   @map("admin_id")
  status            String?
  disposition       String?
  subDisposition    String?   @map("sub_disposition")
  remarks           String?
  queueOrder        Int?      @map("queue_order")
  callAttempts      Int       @default(0) @map("call_attempts")
  rechurnCount      Int       @default(0) @map("rechurn_count")
  lastCallAttempt   DateTime? @map("last_call_attempt")
  disposedBy        String?   @map("disposed_by")
  disposedAt        DateTime? @map("disposed_at")
  leadAmount        Float?    @map("lead_amount")
  transactionId     String?   @map("transaction_id")
  appointmentDt     DateTime? @map("appointment_dt")
  appointmentStatus String?   @map("appointment_status")
  callBackDt        DateTime? @map("call_back_dt")
  conversionDate    DateTime? @map("conversion_date")
  utrCharity        String?   @map("utr_charity")
  charityAmount     Float?    @map("charity_amount")
  isCharityConfirmed Boolean? @default(false) @map("is_charity_confirmed")
  charityConfirmedAt DateTime? @map("charity_confirmed_at")
  charityConfirmedBy String?  @map("charity_confirmed_by")
  isDeleted         Boolean?  @default(false) @map("is_deleted")
  reminderSent      Boolean   @default(false) @map("reminder_sent")
  cbReminderSent    Boolean   @default(false) @map("cb_reminder_sent")
  lateNotified      Boolean   @default(false) @map("late_notified")
  createdAt         DateTime? @default(now()) @map("created_at")
  lastModified      DateTime? @updatedAt @map("last_modified")

  @@index([assignedTo])
  @@index([createdAt])
  @@index([batchId])
  @@index([isDeleted])
  @@index([disposition])
  @@index([appointmentDt])
  @@index([callBackDt])
  @@index([conversionDate])
  @@index([isCharityConfirmed])
  @@index([assignedTo, isDeleted, createdAt])
  @@index([adminId, isDeleted, createdAt])
  @@index([assignedTo, isDeleted, queueOrder, createdAt])
  @@index([assignedTo, disposition, isDeleted, queueOrder, callBackDt])
  @@index([disposition, isDeleted, createdAt])
  @@index([status, isDeleted])
  @@index([disposedAt])
  @@map("contacts")
}

model Lead {
  id           String    @id @default(uuid()) @map("_id")
  contactId    String?   @map("contact_id")
  fields       Json?
  batchId      String?   @map("batch_id")
  assignedTo   String?   @map("assigned_to")
  agentName    String?   @map("agent_name")
  adminId      String?   @map("admin_id")
  leadAmount   Float?    @map("lead_amount")
  transactionId String?  @map("transaction_id")
  utrCharity    String?  @map("utr_charity")
  charityAmount Float?   @map("charity_amount")
  isCharityConfirmed Boolean? @default(false) @map("is_charity_confirmed")
  charityConfirmedAt DateTime? @map("charity_confirmed_at")
  charityConfirmedBy String?  @map("charity_confirmed_by")
  conversionDate DateTime? @map("conversion_date")
  status       String?
  remarks      String?
  createdAt    DateTime? @default(now()) @map("created_at")
  lastModified DateTime? @updatedAt @map("last_modified")

  @@index([assignedTo])
  @@index([adminId])
  @@index([contactId])
  @@index([transactionId])
  @@index([createdAt])
  @@index([conversionDate])
  @@index([isCharityConfirmed])
  @@index([assignedTo, createdAt])
  @@index([adminId, createdAt])
  @@map("leads")
}

model Appointment {
  id            String    @id @default(uuid()) @map("_id")
  contactId     String?   @map("contact_id")
  fields        Json?
  batchId       String?   @map("batch_id")
  assignedTo    String?   @map("assigned_to")
  agentName     String?   @map("agent_name")
  adminId       String?   @map("admin_id")
  appointmentDt DateTime? @map("appointment_dt")
  remarks       String?
  createdAt     DateTime? @default(now()) @map("created_at")
  lastModified  DateTime? @updatedAt @map("last_modified")

  @@index([assignedTo])
  @@index([adminId])
  @@index([contactId])
  @@index([appointmentDt])
  @@index([assignedTo, appointmentDt])
  @@index([adminId, appointmentDt])
  @@map("appointments")
}

model Callback {
  id           String    @id @default(uuid()) @map("_id")
  contactId    String?   @map("contact_id")
  fields       Json?
  batchId      String?   @map("batch_id")
  assignedTo   String?   @map("assigned_to")
  agentName    String?   @map("agent_name")
  adminId      String?   @map("admin_id")
  callBackDt   DateTime? @map("call_back_dt")
  remarks       String?
  status       String?
  source       String?
  createdAt    DateTime? @default(now()) @map("created_at")
  lastModified DateTime? @updatedAt @map("last_modified")

  @@index([assignedTo])
  @@index([adminId])
  @@index([contactId])
  @@index([callBackDt])
  @@index([assignedTo, callBackDt])
  @@index([adminId, callBackDt])
  @@map("callbacks")
}

model Batch {
  id           String    @id @default(uuid()) @map("_id")
  name         String?
  adminId      String?   @map("admin_id")
  status       String    @default("uploaded")
  contactCount Int       @default(0) @map("contact_count")
  isDeleted    Boolean?  @default(false) @map("is_deleted")
  createdAt    DateTime? @default(now()) @map("created_at")
  lastModified DateTime? @updatedAt @map("last_modified")

  @@map("batches")
}
