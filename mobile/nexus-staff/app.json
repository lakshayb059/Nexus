{
  "expo": {
    "name": "Nexus Staff",
    "slug": "nexus-staff",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/nexus-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#070d1f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexuscrm.staff",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture payment receipts for AI OCR transaction verification.",
        "NSPhotoLibraryUsageDescription": "Select payment receipt screenshots for lead conversion."
      }
    },
    "android": {
      "package": "com.nexuscrm.staff",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070d1f"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070d1f",
          "image": "./assets/nexus-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#070d1f",
            "image": "./assets/nexus-logo.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Capture payment receipts for AI OCR verification.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "serverUrl": "https://nexus-2xsa.onrender.com",
      "localServerUrl": "http://10.226.235.50:4000",
      "turnstileSiteKey": "0x4AAAAAAGVQFeiNXzXSirQM",
      "appVariant": "staff",
      "eas": {
        "projectId": "2eccb010-3ace-4047-96fe-e3b26c5b001d"
      }
    }
  }
}
